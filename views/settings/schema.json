{
  "enabled": {
    "description": "启用插件",
    "type": "bool",
    "default": true,
    "hint": ""
  },
  "auto_reply_voice": {
    "description": "自动将模型回复转成语音",
    "type": "bool",
    "default": true,
    "hint": "关闭后仍可由LLM调用语音工具。工具已成功发送时，不会再自动朗读本次最终回复。"
  },
  "tool_enabled": {
    "description": "允许LLM调用发送语音工具",
    "type": "bool",
    "default": true,
    "hint": "提供emotive_send_voice_auto（自动分析语气）和emotive_send_voice_manual（直接传instruction）。遵守私聊/群聊开关和白名单；在工具管理和人格设置中控制可用工具。"
  },
  "tts_mode": {
    "description": "语音API",
    "type": "string",
    "default": "阿里云",
    "options": [
      "阿里云",
      "自定义兼容接口",
      "平台已配置的语音模型"
    ],
    "hint": "先选语音服务类型，面板只显示该类型需要的连接配置。",
    "required": true
  },
  "api_key": {
    "description": "语音API Key",
    "type": "string",
    "default": "",
    "hint": "填写百炼或兼容服务Key；也可通过环境变量DASHSCOPE_API_KEY（阿里模式）或额外请求头提供鉴权，因此此输入框可留空。",
    "secret": true,
    "condition": {
      "tts_mode": [
        "阿里云",
        "自定义兼容接口"
      ]
    }
  },
  "aliyun_region": {
    "description": "阿里云地区",
    "type": "string",
    "default": "北京",
    "options": [
      "北京",
      "新加坡（国际）"
    ],
    "hint": "cosyvoice-v3.5-plus请用北京；Key、模型和音色须属于同一地域。",
    "condition": {
      "tts_mode": [
        "阿里云",
        "平台已配置的语音模型"
      ]
    },
    "required": true
  },
  "aliyun_workspace": {
    "description": "阿里业务空间ID（可选）",
    "type": "string",
    "default": "",
    "hint": "普通调用留空即可。",
    "condition": {
      "tts_mode": "阿里云"
    },
    "collapsed": true
  },
  "tts_endpoint": {
    "description": "自定义接口完整URL",
    "type": "string",
    "default": "https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer",
    "hint": "自定义同步语音API的完整HTTPS地址。请求体和返回方式由下面的模板与选项决定。",
    "condition": {
      "tts_mode": "自定义兼容接口"
    },
    "required": true
  },
  "tts_headers": {
    "description": "自定义请求头（JSON）",
    "type": "text",
    "default": "{}",
    "hint": "可新增多对key/value或粘贴JSON。支持 <api_key> 等动态变量；例如 {\"Authorization\":\"Bearer <api_key>\"}。已保存请求头不回显，重新编辑须完整填写。",
    "condition": {
      "tts_mode": "自定义兼容接口"
    }
  },
  "tts_model": {
    "description": "语音模型ID",
    "type": "string",
    "default": "cosyvoice-v3.5-plus",
    "hint": "首版使用支持自然语言instruction的模型和匹配音色。",
    "condition": {
      "tts_mode": [
        "阿里云",
        "自定义兼容接口"
      ]
    },
    "required": true,
    "required_condition": {
      "tts_mode": "阿里云"
    }
  },
  "voice": {
    "description": "语音音色ID",
    "type": "string",
    "default": "",
    "hint": "阿里模式必须填写；自定义模式仅在请求模板引用 <voice> 时需要。",
    "condition": {
      "tts_mode": [
        "阿里云",
        "自定义兼容接口"
      ]
    },
    "required": true,
    "required_condition": {
      "tts_mode": "阿里云"
    }
  },
  "speech_rate": {
    "description": "语速",
    "type": "float",
    "default": 1.12,
    "hint": "建议保持1.12，最好不要改；较快的语速有助于减少机器感。自动工具使用此值，手动工具使用本次参数（默认1.12）。平台配置复用模式同样有效。",
    "required": true
  },
  "auto_emotion": {
    "description": "根据上下文生成语气",
    "type": "bool",
    "default": true,
    "hint": ""
  },
  "context_messages": {
    "description": "历史消息条数",
    "type": "int",
    "default": 5,
    "hint": "0至50；5是5条，不是5轮；当前输入和当前回复另传。",
    "required": true
  },
  "voice_persona": {
    "description": "语音人设",
    "type": "text",
    "default": "清亮轻巧的女孩声线，声音靠前、轻松柔软，保持音色和性别感一致，语气可爱一些。",
    "hint": "填写声音特点和说话习惯，最多2000字。例如：清亮轻巧的女孩声线，自然灵动，嘴硬心软，安慰人时温柔认真。自动语气分析会结合上文提炼成短指令，不会将整段人设附加给语音模型；留空不额外指定，手动工具不使用。"
  },
  "fallback_instruction": {
    "description": "默认语气指令",
    "type": "text",
    "default": "用普通话，自然聊天，语气贴合内容，情绪克制，停顿短。",
    "hint": "自动分析失败或关闭时使用；最多100加权字符。",
    "required": true
  },
  "analysis_mode": {
    "description": "语气判断模型（与语音API分开）",
    "type": "string",
    "default": "使用AstrBot模型",
    "hint": "只负责把上下文转成instruction，不负责生成声音。",
    "options": [
      "使用AstrBot模型",
      "自定义分析接口"
    ],
    "required": true
  },
  "analysis_provider_id": {
    "description": "语气分析用的聊天模型",
    "type": "string",
    "default": "",
    "hint": "从平台已配置的聊天模型中选择，复用其API配置；未选择时使用默认语气，不跟随当前会话。",
    "condition": {
      "analysis_mode": "使用AstrBot模型"
    },
    "_special": "select_provider",
    "required": true
  },
  "analysis_endpoint": {
    "description": "外部分析完整URL",
    "type": "string",
    "default": "",
    "hint": "例如https://服务域名/v1/chat/completions；仅external模式使用。",
    "condition": {
      "analysis_mode": "自定义分析接口"
    },
    "required": true
  },
  "analysis_model": {
    "description": "外部分析模型名称",
    "type": "string",
    "default": "",
    "hint": "",
    "condition": {
      "analysis_mode": "自定义分析接口"
    },
    "required": true
  },
  "analysis_api_key": {
    "description": "外部分析API Key",
    "type": "string",
    "default": "",
    "hint": "需要鉴权的接口须填写Key，也可通过分析额外请求头提供Authorization；使用请求头鉴权时此框可留空。",
    "condition": {
      "analysis_mode": "自定义分析接口"
    },
    "secret": true
  },
  "analysis_headers": {
    "description": "分析额外请求头JSON",
    "type": "text",
    "default": "{}",
    "hint": "",
    "condition": {
      "analysis_mode": "自定义分析接口"
    }
  },
  "context_max_chars": {
    "description": "历史总字符上限",
    "type": "int",
    "default": 4000,
    "hint": "",
    "collapsed": true,
    "required": true
  },
  "include_persona": {
    "description": "分析时附带有限角色背景",
    "type": "bool",
    "default": true,
    "hint": "最多1500字符，外部分析模式会将此信息发给所配服务。",
    "collapsed": true
  },
  "analysis_timeout": {
    "description": "分析超时秒",
    "type": "int",
    "default": 12,
    "hint": "",
    "collapsed": true,
    "required": true
  },
  "tts_timeout": {
    "description": "合成与下载总超时秒",
    "type": "int",
    "default": 30,
    "hint": "",
    "collapsed": true,
    "required": true
  },
  "job_timeout": {
    "description": "含排队的任务总超时秒",
    "type": "int",
    "default": 75,
    "hint": "",
    "collapsed": true,
    "required": true
  },
  "max_text_chars": {
    "description": "单次朗读字符上限",
    "type": "int",
    "default": 600,
    "hint": "超限保留文字，不强行分句。",
    "required": true
  },
  "private_enabled": {
    "description": "私聊启用",
    "type": "bool",
    "default": true,
    "hint": ""
  },
  "group_enabled": {
    "description": "群聊启用",
    "type": "bool",
    "default": true,
    "hint": ""
  },
  "umo_whitelist": {
    "description": "会话UMO白名单",
    "type": "list",
    "default": [],
    "hint": "留空允许所有会话；填/sid返回的完整UMO。",
    "invisible": true
  },
  "trigger_probability": {
    "description": "语音触发概率",
    "type": "float",
    "default": 1.0,
    "hint": "0至1。",
    "slider": {
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    "required": true
  },
  "send_text_with_voice": {
    "description": "语音后仍发送原文字",
    "type": "bool",
    "default": true,
    "hint": "语音失败始终保留原文字。"
  },
  "concurrency": {
    "description": "并发合成任务数",
    "type": "int",
    "default": 2,
    "hint": "",
    "collapsed": true,
    "required": true
  },
  "queue_capacity": {
    "description": "最大等待及运行任务数",
    "type": "int",
    "default": 16,
    "hint": "",
    "collapsed": true,
    "required": true
  },
  "audio_ttl_seconds": {
    "description": "临时音频保留秒",
    "type": "int",
    "default": 3600,
    "hint": "最少300秒，便于平台读取文件。",
    "collapsed": true,
    "required": true
  },
  "config_revision": {
    "type": "int",
    "description": "配置版本（自动维护）",
    "default": 0,
    "invisible": true
  },
  "private_umo_whitelist": {
    "description": "私聊会话UMO白名单",
    "type": "list",
    "default": [],
    "hint": "每行一个完整私聊UMO（如 default:FriendMessage:123456）。留空不限制该类会话，仍需开启私聊。"
  },
  "group_umo_whitelist": {
    "description": "群聊会话UMO白名单",
    "type": "list",
    "default": [],
    "hint": "每行一个完整群聊UMO（如 default:GroupMessage:123456）。留空不限制该类会话，仍需开启群聊。"
  },
  "whitelist_revision": {
    "description": "白名单迁移版本",
    "type": "int",
    "default": 0,
    "invisible": true
  },
  "tts_provider_id": {
    "description": "平台语音模型",
    "type": "string",
    "default": "",
    "_special": "select_provider_tts",
    "condition": {
      "tts_mode": "平台已配置的语音模型"
    },
    "hint": "复用所选阿里语音提供商的Key、模型、音色、地址和请求头，实际合成由本插件完成，支持动态语气和单次语速。不修改平台配置；暂不支持其他厂商协议。",
    "required": true
  },
  "analysis_debug": {
    "description": "临时打印语气分析日志",
    "type": "bool",
    "default": true,
    "hint": "打印发送给语气LLM的系统提示词、上下文和正文、LLM返回及最终instruction。日志包含聊天内容；调试结束可关闭，不打印API Key、请求头或连接配置。"
  },
  "tts_seed": {
    "description": "正式语音种子",
    "type": "int",
    "default": -1,
    "hint": "-1不主动传种子，使用服务默认；固定种子范围0至65535。可到“种子试听”跨五种语境比较后确认。种子数值不是质量分数，越大不代表越好。"
  },
  "tts_body_template": {
    "description": "自定义请求体（JSON）",
    "type": "text",
    "default": "{\n  \"model\": \"<model>\",\n  \"input\": {\n    \"text\": \"<text>\",\n    \"instruction\": \"<instruction>\",\n    \"voice\": \"<voice>\",\n    \"rate\": \"<speech_rate>\",\n    \"seed\": \"<seed>\",\n    \"format\": \"wav\",\n    \"sample_rate\": 24000\n  }\n}",
    "hint": "支持JSON粘贴或逐项填写。变量：<text> <instruction> <model> <voice> <speech_rate> <seed> <api_key>。整值语速/种子保留数字；seed=-1时省略该字段。模板可能含凭据，已保存内容不回显，留空保留；清除后恢复默认阿里请求体。",
    "condition": {
      "tts_mode": "自定义兼容接口"
    }
  },
  "tts_response_mode": {
    "description": "音频获取方式",
    "type": "string",
    "default": "url",
    "options": [
      "url",
      "binary",
      "base64",
      "hex"
    ],
    "labels": [
      "JSON中的音频网址",
      "直接返回音频文件",
      "JSON中的Base64音频",
      "JSON中的Hex音频"
    ],
    "hint": "支持常见同步HTTP接口，暂不支持SSE、WebSocket或异步任务轮询。",
    "condition": {
      "tts_mode": "自定义兼容接口"
    }
  },
  "tts_audio_path": {
    "description": "音频字段路径",
    "type": "string",
    "default": "output.audio.url",
    "hint": "例如 output.audio.url、data.audio、outputs[0].audio。直接返回文件时无需填写。支持JSON Pointer，如 /data/audio。",
    "condition": {
      "tts_mode": "自定义兼容接口",
      "tts_response_mode": [
        "url",
        "base64",
        "hex"
      ]
    }
  },
  "tts_auto_auth": {
    "description": "根据API Key自动补全Bearer鉴权",
    "type": "bool",
    "default": true,
    "hint": "沿用旧版行为；若仅使用X-API-Key等自定义鉴权，可关闭。显式填写Authorization时以模板为准。",
    "condition": {
      "tts_mode": "自定义兼容接口"
    }
  }
}
